# Supply-chain hardening:
# - No package can run code at install time. The only packages in our locks
#   with install scripts are esbuild (no-op check; its binary ships as a
#   platform optionalDependency) and fsevents (macOS-only, skipped here).
# - New deps get saved with exact versions; ranges make every lockfile
#   regeneration a chance to pull a freshly-compromised patch release.
ignore-scripts=true
save-exact=true
fund=false
