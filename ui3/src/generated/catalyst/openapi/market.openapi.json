  "components": {
    "schemas": {
      "FavoriteList": {
        "type": "object",
        "required": [
          "id",
          "name",
          "userAddress",
          "createdAt",
          "isPrivate",
          "isDefaultList",
          "itemsCount",
          "previewOfItemIds"
        ],
        "properties": {
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "isDefaultList": {
            "type": "boolean",
            "description": "True only for the globally shared default Wishlist (upstream's\n`is_default_list` projection; it also drives the sort-first contract)."
          },
          "isItemInList": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "isPrivate": {
            "type": "boolean"
          },
          "itemsCount": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "permission": {
            "type": [
              "string",
              "null"
            ]
          },
          "previewOfItemIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "updatedAt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "userAddress": {
            "type": "string"
          }
        }
      },
      "FedAck": {
        "type": "object",
        "required": [
          "ok",
          "signature_hash"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "signature_hash": {
            "type": "string"
          }
        }
      },
      "ItemIdData": {
        "type": "object",
        "description": "`data` payload of the item-not-found 404: the missing item id.",
        "required": [
          "itemId"
        ],
        "properties": {
          "itemId": {
            "type": "string"
          }
        }
      },
      "ItemNotFoundBody": {
        "type": "object",
        "description": "404 body for upstream's `ItemNotFoundError`\n(`{ok:false, message:\"The item trying to get saved doesn't exist.\",\ndata:{itemId}}`).",
        "required": [
          "ok",
          "message",
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ItemIdData"
          },
          "message": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "ListIdsData": {
        "type": "object",
        "description": "`data` payload of the lists-not-found 404: the offending list ids.",
        "required": [
          "listIds"
        ],
        "properties": {
          "listIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ListPickItem": {
        "type": "object",
        "description": "One favorited item inside a list, as `GET /v1/lists/{id}/picks` reports it\n(upstream `fromDBGetPickByListIdToPickIdsWithCount`: item id + pick time).",
        "required": [
          "itemId",
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "itemId": {
            "type": "string"
          }
        }
      },
      "ListsEnvelope": {
        "type": "object",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ListsPage"
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "ListsNotFoundBody": {
        "type": "object",
        "description": "404 body for upstream's `ListsNotFoundError`\n(`{ok:false, message:\"Some lists were not found.\", data:{listIds}}`).",
        "required": [
          "ok",
          "message",
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ListIdsData"
          },
          "message": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "ListsPage": {
        "type": "object",
        "required": [
          "results",
          "total",
          "page",
          "pages",
          "limit"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int64"
          },
          "page": {
            "type": "integer",
            "format": "int64"
          },
          "pages": {
            "type": "integer",
            "format": "int64"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FavoriteList"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "MarketErrorBody": {
        "type": "object",
        "required": [
          "ok",
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "PickUnpick404": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ListsNotFoundBody"
          },
          {
            "$ref": "#/components/schemas/ItemNotFoundBody"
          }
        ],
        "description": "The two documented 404 shapes of `POST /v1/picks/{item_id}`. Untagged, so\nit serializes exactly as the inner body while utoipa renders a `oneOf` --\nthe runtime response and the published contract share one definition and\ncannot drift."
      },
      "PickUnpickEnvelope": {
        "type": "object",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PickUnpickResult"
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "PickUnpickInBulkBody": {
        "type": "object",
        "properties": {
          "pickedFor": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "unpickedFrom": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PickUnpickResult": {
        "type": "object",
        "required": [
          "pickedByUser"
        ],
        "properties": {
          "pickedByUser": {
            "type": "boolean"
          }
        }
      },
      "PicksEnvelope": {
        "type": "object",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PicksPage"
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "PicksPage": {
        "type": "object",
        "required": [
          "results",
          "total",
          "page",
          "pages",
          "limit"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int64"
          },
          "page": {
            "type": "integer",
            "format": "int64"
          },
          "pages": {
            "type": "integer",
            "format": "int64"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ListPickItem"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  }
}