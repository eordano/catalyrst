[Unit]
Description=Umbrella catalyrst-presence (user-count collector, port 5152)
After=network.target umbrella-postgres.service
StartLimitIntervalSec=0
Wants=umbrella-postgres.service umbrella-catalyrst-archipelago.service umbrella-catalyrst-comms.service

[Service]
Type=exec
WorkingDirectory=@UMBRELLA_DIR@
# Optional: until the YubiKey handover runs this file does not exist, and a
# non-optional EnvironmentFile fails the unit before ExecStartPre. The
# env/*.env line below is what actually loads today.
EnvironmentFile=-/run/agenix/umbrella-catalyrst-presence-env
EnvironmentFile=-@UMBRELLA_DIR@/env/catalyrst-presence.env
ExecStartPre=@UMBRELLA_DIR@/scripts/wait-pg.sh @BINDIR@
ExecStart=@BINDIR@/catalyrst-presence run
Restart=always
RestartSec=30

[Install]
WantedBy=umbrella.target
