[Unit]
Description=Umbrella catalyrst-explorer-api (realm provider, port 5137)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=@UMBRELLA_DIR@
EnvironmentFile=@UMBRELLA_DIR@/env/common.env
# Optional: until the YubiKey handover runs this file does not exist, and a
# non-optional EnvironmentFile fails the unit before ExecStartPre. The
# env/*.env line below is what actually loads today.
EnvironmentFile=-/run/agenix/umbrella-catalyrst-explorer-api-env
EnvironmentFile=-@UMBRELLA_DIR@/env/catalyrst-explorer-api.env
ExecStart=@BINDIR@/catalyrst-explorer-api
Restart=always
RestartSec=30

[Install]
WantedBy=umbrella.target
