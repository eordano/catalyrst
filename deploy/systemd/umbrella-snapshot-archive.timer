[Unit]
Description=Trigger umbrella-snapshot-archive.service hourly

[Timer]
# Hourly at :40 UTC — the cadence inherited from the retired lore-snapshot-sync
# timer this unit replaces. "0 proposals, 0 votes refreshed" is normal when the
# DAO has posted no new Snapshot proposal recently.
OnCalendar=*-*-* *:40:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
