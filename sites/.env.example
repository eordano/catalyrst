
CATALYST_URL=https://catalyst.example.com

CATALYST_DATABASE_URL=

TELEMETRY_URL=

# Browser-reachable twin of TELEMETRY_URL, baked into the client bundle by vite
# at dev-server/build start. TELEMETRY_URL is loopback-only, so without this
# every browser-side track() call resolves no base and silently drops.
VITE_TELEMETRY_URL=https://catalyst.example.com/telemetry

TELEMETRY_DATABASE_URL=


STRIPE_PUBLISHABLE_KEY=


# /governance/delegate. The roster and voting power read without these; only the
# on-chain setDelegate the visitor signs needs them, and the sign step fails
# closed while they are unset. Mainnet Gnosis delegate registry:
# 0x469788fE6E9E9681C6ebF3bF78e7Fd26Fc015446 on chain 1. Setting these arms a
# real transaction from the visitor's wallet.
SNAPSHOT_DELEGATE_CONTRACT_ADDRESS=
SNAPSHOT_DELEGATE_CHAIN_ID=
# Read-only JSON-RPC used to show who the visitor currently delegates to.
SNAPSHOT_DELEGATE_RPC_URL=
# Snapshot hub for the live vp query (default https://hub.snapshot.org).
SNAPSHOT_API=
SNAPSHOT_SPACE=snapshot.dcl.eth


THIRDWEB_CLIENT_ID=
# WalletConnect Cloud projectId for the mobile-QR sign-in path. Its
# Cloud project must list this deployment\'s origin (catalyst.example.com /
# catalyst.example.com) under allowed origins, or the relay rejects it.
# Injected/EIP-6963 wallets work without this.

