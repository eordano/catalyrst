{
  "name": "sites",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync:assets": "node scripts/sync-ui3-public.mts",
    "predev": "node scripts/sync-ui3-public.mts",
    "prebuild": "node scripts/sync-ui3-public.mts",
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "scripts/e2e-pg.sh vitest run --config vitest.e2e.config.ts",
    "shot": "node scripts/drive/shot.mts",
    "shot:update": "node scripts/drive/shot.mts --update",
    "story:new": "tsx scripts/story-new.ts",
    "story:readout": "tsx scripts/story-readout.ts",
    "story:readout:all": "tsx scripts/story-readout-all.mts",
    "story:doctor": "node scripts/story-doctor.mts",
    "story:play": "cd ../ui3 && npx vitest run --config .storybook/vitest.sites.config.ts sites/packages/features/src/stories",
    "story:machines": "tsx scripts/stories-machines.ts",
    "gen:types": "bash scripts/gen-ts-types.sh",
    "gen:types:check": "bash scripts/gen-ts-check.sh",
    "gen:artefacts": "node scripts/generated-artefacts.mts --write",
    "gen:artefacts:check": "node scripts/generated-artefacts.mts --check",
    "gen:operator": "node scripts/gen-operator-registry.mts",
    "gen:operator:check": "node scripts/gen-operator-registry.mts --check",
    "gen:scene-analytics": "node scripts/gen-scene-analytics-zod.mts",
    "gen:schemas": "node scripts/gen-zod-schemas.mts",
    "gen:schemas:check": "node scripts/gen-zod-schemas.mts --check",
    "schemas:honesty": "node scripts/check-schema-honesty.mts",
    "schemas:honesty:check": "node scripts/check-schema-honesty.mts --check",
    "schemas:honesty:baseline": "node scripts/check-schema-honesty.mts --baseline",
    "schemas:dupes": "node scripts/check-schema-dupes.mts",
    "schemas:dupes:check": "node scripts/check-schema-dupes.mts --check",
    "schemas:dupes:baseline": "node scripts/check-schema-dupes.mts --baseline",
    "telemetry:catalog": "node scripts/telemetry-catalog.mts --write",
    "telemetry:contract": "node scripts/telemetry-catalog.mts --contract",
    "telemetry:check": "node scripts/telemetry-catalog.mts --check",
    "telemetry:metrics:check": "node scripts/telemetry-metrics-check.mts",
    "gen:story-ids": "node scripts/gen-story-id.mts",
    "gen:story-ids:check": "node scripts/gen-story-id.mts --check",
    "sample-size": "tsx scripts/sample-size.ts",
    "check:flowmap": "tsx scripts/check-flowmap-routes.mts",
    "smoke": "node scripts/drive/smoke.mts",
    "gen:seed-catalog": "node scripts/gen-seed-catalog.mjs",
    "gen:seed-catalog:check": "node scripts/gen-seed-catalog.mjs --check"
  },
  "dependencies": {
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@stripe/react-stripe-js": "6.8.1",
    "@stripe/stripe-js": "9.13.0",
    "@tanstack/react-query": "5.101.4",
    "@xstate/react": "6.1.0",
    "gray-matter": "4.0.3",
    "isbot": "5.2.1",
    "livekit-client": "2.22.0",
    "livekit-server-sdk": "2.17.0",
    "monaco-editor": "0.53.0",
    "pg": "8.23.0",
    "qrcode-generator": "2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "three": "0.185.1",
    "viem": "2.55.17",
    "xstate": "5.32.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "8.3.0",
    "@react-router/fs-routes": "8.3.0",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@xstate/graph": "3.0.4",
    "openapi-typescript": "6.7.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
