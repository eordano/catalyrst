# catalyrst-governance -- archiver + read API over the Decentraland governance API
# Install to <WORKSPACE>/env/catalyrst-governance.env

# --- HTTP server -----------------------------------------------------------
# Bind address and port for the read API. Services bind 127.0.0.1.
HTTP_SERVER_HOST=127.0.0.1
HTTP_SERVER_PORT=5151

# --- Postgres --------------------------------------------------------------
# Connection string for the governance archive database (REQUIRED).
# Prefer the unix-socket form against the shared cluster on port 5433.
GOVERNANCE_PG_COMPONENT_PSQL_CONNECTION_STRING="postgresql:///governance?host=<DB_HOST>&port=5433&user=<DB_USER>&password=<DB_PASSWORD>"

# --- Upstream API ----------------------------------------------------------
# Base URL of the Decentraland governance API (no trailing slash needed).
# REQUIRED (no code default) -- upstream governance API mirrored into our DB.
GOVERNANCE_API_URL=https://governance.decentraland.org/api

# --- Background sync -------------------------------------------------------
# When true, `serve` spawns a background loop that runs an incremental sync
# every GOVERNANCE_SYNC_WINDOW_HOURS. Default: false.
GOVERNANCE_POLL_ENABLED=false

# Look-back window AND loop cadence, in hours. Default: 48.
GOVERNANCE_SYNC_WINDOW_HOURS=48

# --- Snapshot proposal submission (POST /proposals/<type>) ------------------
# Every var in this block is unset by default. With any one of the four
# required vars missing the service logs a startup WARN naming it and every
# POST /proposals/<type> answers 503 without signing or sending anything.
#
# A configured signer creates REAL proposals in a REAL Snapshot space that
# start a REAL voting period. Point SNAPSHOT_SPACE at a space you own before
# ever setting SNAPSHOT_PRIVATE_KEY, and never commit the key.

# REQUIRED -- private key of the wallet authorised to post in the space.
# SNAPSHOT_PRIVATE_KEY=

# REQUIRED -- snapshot space id, e.g. snapshot.dcl.eth for the Decentraland DAO.
# SNAPSHOT_SPACE=

# REQUIRED -- snapshot hub or sequencer URL. A hub URL is rewritten to its
# sequencer exactly as snapshot.js does (hub.snapshot.org -> seq.snapshot.org).
# SNAPSHOT_API=https://hub.snapshot.org

# REQUIRED -- Ethereum JSON-RPC endpoint, used once per submission for
# eth_blockNumber: the block the proposal's voting power is measured at.
# SNAPSHOT_BLOCK_RPC_URL=

# Address the envelope is posted as. Defaults to the address of
# SNAPSHOT_PRIVATE_KEY; set it only when the space authorises an alias.
# SNAPSHOT_ADDRESS=

# Council space id. Required by POST /proposals/council-decision-veto, which
# links the vetoed decision inside this space.
# SNAPSHOT_SPACE_COUNCIL=

# Snapshot web UI base used to build those decision links.
# SNAPSHOT_WEB_URL=https://snapshot.org

# Governance dApp base used to link a proposal's parent draft/pitch/tender.
# GOVERNANCE_PUBLIC_URL=https://decentraland.org/governance

# Voting window in seconds, applied to every type without an override below.
# GATSBY_SNAPSHOT_DURATION=604800

# Per-type voting window overrides, in seconds.
# GATSBY_DURATION_GOVERNANCE=
# GATSBY_DURATION_HIRING=
# DURATION_TENDER=
# DURATION_COUNCIL_DECISION_VETO=

# Delay between a tender's creation and the start of its voting period, in
# seconds. Default 0.
# SUBMISSION_WINDOW_DURATION_TENDER=

# --- Logging ---------------------------------------------------------------
RUST_LOG=catalyrst_governance=info,tower_http=info
