  "query": "\n        SELECT d.entity_id, d.id, d.entity_pointers\n        FROM active_pointers ap\n        JOIN deployments d ON d.entity_id = ap.entity_id\n        WHERE ap.pointer = $1 AND d.entity_type = 'scene'\n        ",
