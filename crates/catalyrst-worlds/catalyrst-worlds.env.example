
HTTP_SERVER_HOST=127.0.0.1
HTTP_SERVER_PORT=5141

WORLDS_PG_CONNECTION_STRING="postgresql:///worlds?host=<RUN_DIR>&port=5433&user=<DB_USER>&password=<DB_PASSWORD>"

HTTP_BASE_URL="https://worlds.example.com"

NETWORK_ID=1


# REQUIRED -- the public URLs this realm advertises in /about.
CONTENT_PUBLIC_URL=""
LAMBDAS_PUBLIC_URL=""

LIVEKIT_HOST="<HOST>"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret"
LIVEKIT_WEBHOOK_KEY=""
MAX_USERS_PER_WORLD=100

# Empty = serve 404 on a local miss rather than read through to another network.
CONTENTS_UPSTREAM_URL=""


# Worlds federation (OFF by default -- leave WORLDS_FED_PEERS_FILE unset)
#
# Path to the DAO-gated peer allowlist. Unset (the default) means federation was
# never requested: the service boots normally and /federation/worlds/* answers 503
# naming this variable. It never returns an empty peer list, because "we federate
# with nobody" and "we forgot to look" must not be the same observable state.
#
# SET, it is read and adjudicated at boot, and any of these aborts startup:
#   - the file is missing, unreadable, or not valid TOML
#   - an entry's dao_proposal still says "TODO" or carries the <space>/<id> markers
#   - an entry's added_at is still 1970-01-01
#   - an entry's gossip_pubkey is 32 zero bytes
#   - an entry's peer_id ends in .invalid/.example/.test/.localhost/.local
#   - an entry has an empty mtls_root_pem (no pinned root => no peer identity)
#   - an entry's worlds_url does not parse, is not https, or has no host
# An entry with a valid everything and an EMPTY worlds_url is not an error: it is a
# peer that federates other scopes and runs no worlds server. It is omitted and
# listed on GET /federation/worlds/peers so the omission is never silent.
#
# The file shipped at deploy/config/federation-peers.toml is a placeholder and is
# refused five ways over. See deploy/config/federation-peers.example.toml for the
# real shape.
# WORLDS_FED_PEERS_FILE="/etc/catalyrst/federation-peers.toml"

# Seconds between polls of each admitted peer. Must be >= 1; 0 or unparseable
# aborts startup rather than becoming a busy loop against someone else's server.
# WORLDS_FED_POLL_INTERVAL_SECS=300

# Hard cap on a peer response, enforced by a streaming byte counter BEFORE parse.
# The production worlds corpus is ~2.1 MB, so 4 MiB is ~2x head-room.
# WORLDS_FED_MAX_RESPONSE_BYTES=4194304

# Hard cap on mirrored rows per peer. Same corpus is 1552 worlds.
# WORLDS_FED_MAX_WORLDS_PER_PEER=10000

# DEV ONLY. Permits http://127.0.0.1:*, http://[::1]:* and http://localhost:* peers
# with an empty mtls_root_pem, so the two-node local test can run against a server
# that has no TLS terminator. It applies to a LITERAL loopback host only -- a
# non-loopback host is still refused with this set -- and every peer admitted through
# it logs a WARN naming this variable. Never set it outside a local test: with it,
# nothing establishes that the process answering the port is the peer.
# WORLDS_FED_ALLOW_INSECURE_LOOPBACK_PEERS=0




RUST_LOG=catalyrst_worlds=info,tower_http=info
